---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { proseClasses } from '../../data/ui';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
      position: i + 1,
      total: projects.length,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
  position: number;
  total: number;
}

const { project, prev, next, position, total } = Astro.props;
const { data, id } = project;
const { Content } = await render(project);

const og = await getImage({ src: data.cover, width: 1200, format: 'jpg', quality: 82 });
const host = data.live ? new URL(data.live).host.replace(/^www\./, '') : null;
const lightboxImages = await Promise.all(
  data.gallery.map(async (g) => ({ ...g, full: (await getImage({ src: g.src, width: 1800, format: 'webp' })).src })),
);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  headline: data.tagline,
  description: data.summary,
  dateCreated: data.year,
  url: `${site.url}/projects/${id}`,
  image: new URL(og.src, site.url).href,
  creator: { '@id': `${site.url}/#person` },
  keywords: data.stack.join(', '),
  ...(data.live ? { sameAs: data.live } : {}),
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects` },
    { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/projects/${id}` },
  ],
};
---

<Base title={data.title} description={data.summary} image={og.src} type="article" jsonLd={[ld, crumbs]}>
  <article style={`--accent:${data.accent}`}>
    <header class="relative overflow-hidden pt-36 pb-12 md:pt-40">
      <div
        class="pointer-events-none absolute -top-48 left-1/2 h-[36rem] w-[60rem] -translate-x-1/2 rounded-full opacity-25 blur-[140px]"
        style="background: var(--accent)"
        aria-hidden="true"
      >
      </div>
      <div class="container-x relative">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 font-mono text-xs text-faint" data-reveal>
          <a href="/" class="hover:text-ink">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/projects" class="hover:text-ink">Projects</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page" class="text-muted">{data.title}</span>
        </nav>

        <div class="mt-8 flex flex-wrap items-center gap-3 font-mono text-xs" data-reveal style="--d:1">
          <span class="rounded-full border border-line px-3 py-1 text-ink">{data.category}</span>
          <span class="text-muted">{data.year}</span>
          <span class="text-muted" aria-label={`Project ${position} of ${total}`}>{String(position).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
          {
            data.live && (
              <span class="inline-flex items-center gap-2 text-emerald-300">
                <span class="live-dot" aria-hidden="true" /> Live
              </span>
            )
          }
        </div>

        <h1 class="mt-5 max-w-5xl font-display text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.95] font-bold">
          <span transition:name={`title-${id}`} class="inline-block">{data.title}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-xl leading-relaxed text-muted md:text-2xl" data-reveal style="--d:2">{data.tagline}</p>

        <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d:3">
          {
            data.live && (
              <a href={data.live} target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-magnetic>
                Visit {host}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            )
          }
          {
            data.links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                {l.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <div class="container-x">
      <div class="overflow-hidden rounded-[2rem] border border-line bg-surface shadow-[0_40px_120px_-40px_var(--accent)]">
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1280px) 1216px, 94vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/9] w-full object-cover"
          transition:name={`cover-${id}`}
        />
      </div>
    </div>

    <div class="container-x mt-16 grid gap-14 lg:grid-cols-[1fr_20rem]">
      <div>
        <p class="text-lg leading-relaxed text-ink md:text-xl" data-reveal>{data.summary}</p>
        <div class:list={[proseClasses, 'mt-4']}>
          <Content />
        </div>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start" aria-label="Project facts">
        <dl class="glass grid gap-6 rounded-3xl p-6" data-reveal>
          <div>
            <dt class="font-mono text-[11px] tracking-[0.2em] text-faint uppercase">Role</dt>
            <dd class="mt-1.5 text-sm text-ink">{data.role}</dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] tracking-[0.2em] text-faint uppercase">Year</dt>
            <dd class="mt-1.5 text-sm text-ink">{data.year}</dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] tracking-[0.2em] text-faint uppercase">Stack</dt>
            <dd class="mt-2.5">
              <ul class="flex flex-wrap gap-2">
                {data.stack.map((s) => <li class="chip">{s}</li>)}
              </ul>
            </dd>
          </div>
          {
            data.highlights.length > 0 && (
              <div>
                <dt class="font-mono text-[11px] tracking-[0.2em] text-faint uppercase">Highlights</dt>
                <dd class="mt-2.5">
                  <ul class="grid gap-2.5 text-sm text-muted">
                    {data.highlights.map((h) => (
                      <li class="flex gap-2.5">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full" style="background: var(--accent)" aria-hidden="true" />
                        {h}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
    </div>

    {
      lightboxImages.length > 0 && (
        <section class="container-x mt-24" aria-labelledby="gallery-title">
          <h2 id="gallery-title" class="font-display text-3xl font-semibold" data-reveal>
            Gallery
          </h2>
          <ul class="mt-8 columns-1 gap-5 sm:columns-2 [&>li]:mb-5">
            {lightboxImages.map((g, i) => (
              <li class="break-inside-avoid" data-reveal style={`--d:${i % 3}`}>
                <figure>
                  <button
                    type="button"
                    data-lightbox={g.full}
                    data-alt={g.alt}
                    data-caption={g.caption ?? ''}
                    class="group block w-full overflow-hidden rounded-3xl border border-line"
                    aria-label={`Enlarge image: ${g.alt}`}
                  >
                    <Image
                      src={g.src}
                      alt=""
                      widths={[480, 800, 1100]}
                      sizes="(min-width: 640px) 45vw, 92vw"
                      class="w-full transition-transform duration-700 group-hover:scale-[1.03]"
                    />
                  </button>
                  {g.caption && <figcaption class="mt-3 text-sm text-muted">{g.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>

          <dialog
            data-lightbox-dialog
            class="m-auto max-h-[92vh] max-w-[94vw] overflow-visible bg-transparent p-0 text-ink backdrop:bg-black/85 backdrop:backdrop-blur-sm"
            aria-label="Image viewer"
          >
            <figure class="relative">
              <img src="" alt="" class="max-h-[80vh] w-auto rounded-2xl" />
              <figcaption data-lightbox-caption class="mt-3 text-center text-sm text-muted" />
            </figure>
            <div class="mt-3 flex justify-center gap-2">
              <button type="button" data-lightbox-nav="-1" class="btn btn-ghost !py-2">
                ← Previous
              </button>
              <button type="button" data-lightbox-close class="btn btn-primary !py-2" autofocus>
                Close
              </button>
              <button type="button" data-lightbox-nav="1" class="btn btn-ghost !py-2">
                Next →
              </button>
            </div>
          </dialog>
        </section>
      )
    }

    <!-- Previous / next -->
    <nav class="container-x mt-28 mb-10" aria-label="More projects">
      <div class="grid gap-5 md:grid-cols-2">
        {
          [
            { p: prev, label: 'Previous project', dir: 'prev' },
            { p: next, label: 'Next project', dir: 'next' },
          ].map(({ p, label, dir }) => (
            <a
              href={`/projects/${p.id}`}
              class:list={[
                'spot-card group relative flex min-h-56 overflow-hidden rounded-[1.75rem] border border-line p-7',
                dir === 'next' ? 'md:justify-end md:text-right' : '',
              ]}
              data-tilt="off"
            >
              <Image
                src={p.data.cover}
                alt=""
                widths={[480, 800]}
                sizes="(min-width: 768px) 45vw, 92vw"
                class="absolute inset-0 h-full w-full object-cover opacity-30 transition-all duration-700 group-hover:scale-105 group-hover:opacity-45"
              />
              <span class="absolute inset-0 bg-gradient-to-t from-bg via-bg/70 to-bg/20" aria-hidden="true" />
              <span class="relative z-[2] mt-auto">
                <span class="font-mono text-xs tracking-[0.2em] text-cyan uppercase">
                  {dir === 'prev' ? '← ' : ''}
                  {label}
                  {dir === 'next' ? ' →' : ''}
                </span>
                <span class="mt-2 block font-display text-2xl font-semibold md:text-3xl">{p.data.title}</span>
                <span class="mt-1 block text-sm text-muted">{p.data.category}</span>
              </span>
            </a>
          ))
        }
      </div>
      <p class="mt-10 text-center">
        <a href="/projects" class="btn btn-ghost">Back to all projects</a>
      </p>
    </nav>
  </article>
</Base>
