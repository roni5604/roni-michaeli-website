---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TechBadges from './TechBadges.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'rail' | 'grid';
  index?: number;
  eager?: boolean;
}

const { project, variant = 'grid', index = 0, eager = false } = Astro.props;
const { data, id } = project;
const href = `/projects/${id}`;
const host = data.live ? new URL(data.live).host.replace(/^www\./, '') : null;
const liveLabel = host && host.endsWith('github.io') ? 'Live demo' : host;
---

<article
  class:list={[
    'spot-card group relative flex flex-col overflow-hidden rounded-[1.75rem] border border-line bg-surface/80 hover:border-line-strong',
    variant === 'rail' ? 'w-[min(86vw,30rem)] shrink-0 snap-start lg:w-[34rem]' : 'h-full',
  ]}
  style={`--accent:${data.accent}`}
  data-hscroll-item={variant === 'rail' ? '' : undefined}
>
  <div class="relative aspect-[16/10] overflow-hidden">
    <Image
      src={data.cover}
      alt={data.coverAlt}
      widths={[480, 720, 960]}
      sizes={variant === 'rail' ? '(min-width: 1024px) 34rem, 86vw' : '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw'}
      loading={eager ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
      transition:name={`cover-${id}`}
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-90" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-4 left-4 z-[2] flex flex-wrap gap-2">
      <span class="rounded-full bg-bg/70 px-3 py-1 font-mono text-[11px] text-ink backdrop-blur">{data.category}</span>
      {
        data.live && (
          <span class="inline-flex items-center gap-2 rounded-full bg-bg/70 px-3 py-1 font-mono text-[11px] text-emerald-300 backdrop-blur">
            <span class="live-dot" aria-hidden="true" />
            Live
          </span>
        )
      }
    </div>
    <span class="pointer-events-none absolute top-4 right-4 z-[2] font-mono text-[11px] text-ink/80" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <div class="flex flex-1 flex-col p-6 md:p-7">
    <p class="font-mono text-[11px] tracking-wider text-faint uppercase">{data.year}</p>
    <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight">
      <a href={href} class="outline-none after:absolute after:inset-0 after:z-[1] after:rounded-[1.75rem] focus-visible:after:outline-2 focus-visible:after:outline-cyan">
        <span transition:name={`title-${id}`} class="inline-block">{data.title}</span>
      </a>
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">{data.tagline}</p>
    <div class="mt-5 border-t border-line pt-4">
      <TechBadges languages={data.languages} skills={data.stack} maxSkills={variant === 'rail' ? 5 : 4} />
    </div>
    <div class="mt-auto flex items-center justify-between gap-3 pt-6">
      <span class="inline-flex items-center gap-2 text-sm font-semibold text-ink" aria-hidden="true">
        Case study
        <svg class="transition-transform duration-300 group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          ><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
        >
      </span>
      {
        data.live && (
          <a
            href={data.live}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-[3] inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:border-[var(--accent)] hover:text-ink"
          >
            {liveLabel}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
            <span class="sr-only">(visit live site of {data.title}, opens in a new tab)</span>
          </a>
        )
      }
    </div>
  </div>
</article>
