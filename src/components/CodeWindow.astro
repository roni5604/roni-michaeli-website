---
import { Code } from 'astro:components';

// A small, generic snippet — decorative only, not taken from any project.
const code = `type Idea = { name: string; impact: number };

function build(idea: Idea) {
  const plan = design(idea);
  const product = code(plan);

  test(product);
  return launch(product);
}

build({ name: 'your next product', impact: Infinity });`;
---

<div
  class="code-window overflow-hidden rounded-3xl border border-line bg-[#0a0f1c] shadow-[0_30px_80px_-30px_rgb(34_211_238/0.35)]"
  role="img"
  aria-label="Decorative code editor window"
>
  <div class="flex items-center gap-4 border-b border-line bg-bg-2/80 px-4 py-3" aria-hidden="true">
    <div class="flex gap-1.5">
      <span class="h-3 w-3 rounded-full bg-[#f87171]"></span>
      <span class="h-3 w-3 rounded-full bg-[#fbbf24]"></span>
      <span class="h-3 w-3 rounded-full bg-[#34d399]"></span>
    </div>
    <span class="font-mono text-xs text-muted">build.ts</span>
  </div>
  <div class="overflow-x-auto text-[12.5px] leading-6 md:text-[13px]" aria-hidden="true" data-code-reveal>
    <Code code={code} lang="ts" theme="tokyo-night" />
  </div>
</div>

<style>
  .code-window :global(pre.astro-code) {
    margin: 0;
    padding: 1.25rem 1.25rem 1.25rem 0;
    background: transparent !important;
    counter-reset: line;
    min-width: max-content;
  }
  .code-window :global(pre.astro-code .line) {
    display: inline-block;
    min-width: 100%;
  }
  .code-window :global(pre.astro-code .line::before) {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 3rem;
    margin-right: 1rem;
    text-align: right;
    color: rgb(129 144 166 / 0.55);
  }
  /* lift the theme's dim comment colour to meet WCAG AA contrast */
  .code-window :global([style*='#51597D' i]) {
    color: #8e97bf !important;
  }
  :global(html.js:not(.reduce-motion)) [data-code-reveal] :global(.line) {
    opacity: 0;
    translate: -8px 0;
    transition:
      opacity 0.5s var(--ease-out-expo),
      translate 0.5s var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 60ms);
  }
  :global(html.js:not(.reduce-motion)) [data-code-reveal].is-typed :global(.line) {
    opacity: 1;
    translate: none;
  }
</style>
