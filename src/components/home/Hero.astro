---
import { Picture } from 'astro:assets';
import roni from '../../assets/roni.jpg';
import { site, roles } from '../../data/site';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const liveCount = projects.filter((p) => p.data.live).length;
---

<section class="relative flex min-h-[100svh] items-center overflow-hidden pt-28 pb-16" aria-labelledby="hero-title">
  <canvas data-binary class="pointer-events-none absolute inset-0 h-full w-full opacity-0 transition-opacity duration-[1500ms]" aria-hidden="true"
  ></canvas>
  <!-- keeps text readable over the digits: strong behind the copy, clear around the portrait -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgb(5_7_13/0.75),rgb(5_7_13/0.45)_40%,rgb(5_7_13/0.1)_75%)] max-lg:bg-bg/40"
    aria-hidden="true"
  ></div>
  <div class="pointer-events-none absolute -top-32 -left-40 h-[36rem] w-[36rem] rounded-full bg-cyan/15 blur-[120px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-40 bottom-0 h-[34rem] w-[34rem] rounded-full bg-violet/15 blur-[120px]" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-14 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <p data-reveal class="mb-6 inline-flex items-center gap-3 rounded-full border border-line bg-surface/60 px-4 py-1.5 text-xs text-muted backdrop-blur">
        <span class="live-dot" aria-hidden="true"></span>
        {site.status} · {site.location}
      </p>

      <p data-reveal style="--d:1" class="eyebrow mb-5">{site.role}</p>

      <h1 id="hero-title" class="font-display text-[clamp(3.2rem,9vw,7.5rem)] leading-[0.92] font-bold tracking-[-0.045em]">
        <span class="sr-only">{site.name}</span>
        <span aria-hidden="true" class="block" data-scramble="Roni" data-delay="150">Roni</span>
        <span aria-hidden="true" class="text-gradient block" data-scramble="Michaeli" data-delay="450">Michaeli</span>
      </h1>

      <p data-reveal style="--d:3" class="mt-8 max-w-xl text-lg leading-relaxed text-muted md:text-xl">
        <span class="text-ink">B.Sc. Computer Science &amp; Mathematics</span> graduate. I write clean, efficient code myself — and I specialise in
        <span class="text-ink">working with AI</span> to build complete products: games, web &amp; mobile apps and machine-learning models.
      </p>

      <div data-reveal style="--d:4" class="mt-7 inline-flex max-w-full items-center gap-2 rounded-xl border border-line bg-bg-2/80 px-4 py-3 font-mono text-sm">
        <span class="text-pink" aria-hidden="true">❯</span>
        <span class="text-faint">roni</span>
        <span class="sr-only">— {roles.join(', ')}</span>
        <span aria-hidden="true" class="truncate text-cyan" data-typewriter={JSON.stringify(roles)}>{roles[0]}</span>
        <span aria-hidden="true" class="motion-safe:animate-pulse inline-block h-4 w-2 bg-cyan/80"></span>
      </div>

      <div data-reveal style="--d:5" class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#work" class="btn btn-primary" data-magnetic>
          See my projects
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
        </a>
        <a href="#contact" class="btn btn-ghost" data-magnetic>Hire me</a>
        <a href={site.cv} target="_blank" rel="noopener" class="btn text-muted hover:text-ink">
          Download CV <span class="sr-only">(PDF, opens in a new tab)</span>
        </a>
        <span class="flex items-center gap-2">
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="grid h-11 w-11 place-items-center rounded-full border border-line text-muted transition-colors hover:border-cyan hover:text-ink" aria-label="LinkedIn (opens in a new tab)" data-magnetic="0.25">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"></path></svg>
          </a>
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="grid h-11 w-11 place-items-center rounded-full border border-line text-muted transition-colors hover:border-cyan hover:text-ink" aria-label="GitHub (opens in a new tab)" data-magnetic="0.25">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"></path></svg>
          </a>
        </span>
      </div>

      <dl data-reveal style="--d:6" class="mt-14 grid max-w-lg grid-cols-3 gap-6 border-t border-line pt-8">
        <div>
          <dt class="text-xs tracking-wider text-faint uppercase">Projects</dt>
          <dd class="mt-1 font-display text-3xl font-semibold" data-count={projects.length}>{projects.length}</dd>
        </div>
        <div>
          <dt class="text-xs tracking-wider text-faint uppercase">Live products</dt>
          <dd class="mt-1 font-display text-3xl font-semibold" data-count={liveCount}>{liveCount}</dd>
        </div>
        <div>
          <dt class="text-xs tracking-wider text-faint uppercase">Languages I code in</dt>
          <dd class="mt-1 font-display text-3xl font-semibold"><span data-count="10" data-suffix="+">10+</span></dd>
        </div>
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[25rem] lg:max-w-none">
      <div data-parallax class="relative">
        <div class="photo-ring relative rounded-[2.2rem] p-[2px] shadow-[0_40px_120px_-30px_rgb(34_211_238/0.45)]">
          <div class="overflow-hidden rounded-[calc(2.2rem-2px)] bg-surface">
            <Picture
              src={roni}
              formats={['avif', 'webp']}
              widths={[420, 640, 900]}
              sizes="(min-width: 1024px) 34vw, 90vw"
              alt="Portrait of Roni Michaeli in a light suit, smiling, in a sunlit garden"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/5] w-full object-cover object-[50%_18%]"
            />
          </div>
        </div>

        <div class="glass absolute -left-6 top-10 hidden rounded-2xl px-4 py-3 sm:block" data-float="18" aria-hidden="true">
          <p class="font-mono text-[10px] tracking-widest text-faint uppercase">Status</p>
          <p class="mt-1 flex items-center gap-2 text-sm font-semibold"><span class="live-dot"></span> Available for work</p>
        </div>
        <div class="glass absolute -right-4 bottom-24 hidden rounded-2xl px-4 py-3 sm:block" data-float="30" aria-hidden="true">
          <p class="flex items-center gap-2 text-sm font-semibold"><span class="text-cyan">{'</>'}</span> Python · TypeScript · C#</p>
        </div>
        <div class="glass absolute -bottom-6 left-8 rounded-2xl px-4 py-3" data-float="12" aria-hidden="true">
          <p class="font-mono text-xs text-muted"><span class="text-lime">✓</span> B.Sc. CS &amp; Mathematics</p>
        </div>
      </div>
    </div>
  </div>

  <a href="#skills" class="group absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs text-faint md:flex">
    <span class="sr-only">Scroll to skills</span>
    <span class="grid h-11 w-7 place-items-start justify-center rounded-full border border-line-strong pt-2 group-hover:border-cyan" aria-hidden="true">
      <span class="h-2 w-1 rounded-full bg-cyan motion-safe:animate-bounce"></span>
    </span>
  </a>
</section>
