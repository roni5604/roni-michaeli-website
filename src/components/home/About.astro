---
import { Image } from 'astro:assets';
import roni from '../../assets/roni.jpg';
import CodeWindow from '../CodeWindow.astro';
---

<section id="about" class="relative py-28 md:py-36" aria-labelledby="about-title">
  <div class="container-x">
    <p class="eyebrow" data-reveal>About</p>
    <h2 id="about-title" class="mt-5 max-w-4xl text-4xl font-semibold md:text-6xl" data-split>
      Computer scientist. Hands-on coder. AI specialist.
    </h2>

    <div class="mt-16 grid gap-5 md:grid-cols-6 [&>*]:min-w-0">
      <!-- Bio -->
      <article data-reveal class="spot-card glass rounded-3xl p-8 md:col-span-4 md:row-span-2" data-tilt="off">
        <div class="relative z-[2]">
          <p class="font-mono text-xs tracking-[0.2em] text-cyan uppercase">The short version</p>
          <p class="mt-6 text-xl leading-relaxed text-ink md:text-2xl">
            I'm Roni — a software developer with a <strong class="font-semibold">B.Sc. in Computer Science &amp; Mathematics</strong> from Ariel University.
            I write my own code, and I love taking hard problems all the way from idea to a working product.
          </p>
          <p class="mt-6 leading-relaxed text-muted">
            It started in high school, where I majored in computer science and never stopped. Since then I’ve written code in C, C++, C#, Java, Python,
            Dart and TypeScript — algorithms, simulations, deep-learning models, Android apps, websites and games — and spent years teaching CS and maths to
            university students.
          </p>
          <p class="mt-6 leading-relaxed text-muted">
            Today I specialise in <span class="text-ink">working with AI</span>: I design and write the core logic myself, and use AI coding agents with
            tests and reviews to build complete products — a Flutter word game, a seven-game multiplayer card platform, an open Hebrew dataset — at a pace
            that used to need a team.
          </p>
          <p class="mt-6 inline-flex items-center gap-3 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-4 py-2 text-sm text-emerald-200">
            <span class="live-dot" aria-hidden="true"></span>
            Available now for a full-time developer role — full-stack, backend or AI-focused.
          </p>
        </div>
      </article>

      <!-- Portrait crop -->
      <figure data-reveal style="--d:1" class="spot-card group relative hidden overflow-hidden rounded-3xl border border-line md:col-span-2 md:row-span-2 md:block">
        <Image
          src={roni}
          widths={[360, 560, 760]}
          sizes="(min-width: 768px) 30vw, 90vw"
          alt="Roni Michaeli, hands in pockets, wearing a light beige suit"
          class="h-full min-h-[22rem] w-full object-cover object-[50%_30%] transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-105"
        />
        <figcaption class="absolute inset-x-0 bottom-0 z-[2] bg-gradient-to-t from-bg via-bg/70 to-transparent p-6">
          <p class="font-display text-lg font-semibold">Roni Michaeli</p>
          <p class="text-sm text-muted">Israel · Hebrew (native), English (fluent)</p>
        </figcaption>
      </figure>

      <!-- Code window -->
      <div data-reveal style="--d:2" class="min-w-0 md:col-span-4">
        <CodeWindow />
      </div>

      <!-- Stats + roots -->
      <div class="grid gap-5 md:col-span-2">
        <div data-reveal style="--d:3" class="glass grid grid-cols-2 divide-x divide-line rounded-3xl">
          <div class="p-5 text-center">
            <p class="font-display text-3xl font-bold text-gradient">B.Sc.</p>
            <p class="mt-1 text-xs tracking-wider text-faint uppercase">CS &amp; Maths</p>
          </div>
          <div class="p-5 text-center">
            <p class="font-display text-3xl font-bold"><span data-count="14">14</span></p>
            <p class="mt-1 text-xs tracking-wider text-faint uppercase">Projects</p>
          </div>
        </div>
        <article data-reveal style="--d:4" class="spot-card glass rounded-3xl p-6" data-tilt="off">
          <div class="relative z-[2]">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-cyan/10 text-cyan" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 9-3 3 3 3M16 9l3 3-3 3M13.5 6l-3 12"></path></svg>
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold">Coding since high school</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              5 units of Computer Science, Network Management and Physics — the start of a long love affair with computers.
            </p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
