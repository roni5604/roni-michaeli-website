---
import { getCollection } from 'astro:content';
import ProjectCard from '../ProjectCard.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
---

<section id="work" data-hscroll class="relative overflow-hidden py-28 lg:flex lg:min-h-screen lg:flex-col lg:justify-center lg:py-16" aria-labelledby="work-title">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow" data-reveal>Selected projects</p>
        <h2 id="work-title" class="mt-5 text-4xl font-semibold md:text-6xl lg:text-5xl xl:text-6xl" data-split>Code I wrote. Products I built.</h2>
      </div>
      <div class="flex items-center gap-4" data-reveal style="--d:1">
        <p class="hidden max-w-xs text-sm text-muted lg:block">Scroll through the projects — open any of them for how it works and how I built it.</p>
        <a href="/projects" class="btn btn-ghost" data-magnetic>
          All {all.length} projects
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </div>

  <div
    data-hscroll-track
    class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-6 [scrollbar-width:none] sm:px-8 lg:mt-10 [.is-pinned_&]:snap-none [.is-pinned_&]:overflow-visible lg:px-[max(2rem,calc((100vw-80rem)/2+2rem))] [&::-webkit-scrollbar]:hidden"
    role="list"
    aria-label="Featured projects"
  >
    {
      featured.map((p, i) => (
        <div role="listitem" class="contents">
          <ProjectCard project={p} variant="rail" index={i} />
        </div>
      ))
    }
    <div role="listitem" class="contents">
      <a
        href="/projects"
        data-hscroll-item
        class="group grid w-[min(70vw,22rem)] shrink-0 snap-start place-items-center rounded-[1.75rem] border border-dashed border-line-strong p-10 text-center transition-colors hover:border-cyan"
      >
        <span>
          <span class="block font-display text-5xl font-semibold text-gradient">+{all.length - featured.length}</span>
          <span class="mt-3 block text-muted group-hover:text-ink">more projects in AI, simulation, data and web →</span>
        </span>
      </a>
    </div>
  </div>

  <div class="container-x mt-6 hidden lg:block" aria-hidden="true">
    <div class="h-px w-full bg-line">
      <div data-hscroll-progress class="h-px w-full origin-left scale-x-0 bg-gradient-to-r from-cyan via-violet to-pink"></div>
    </div>
  </div>
</section>
