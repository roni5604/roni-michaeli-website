---
import { journey } from '../../data/site';
---

<section id="journey" class="relative py-28 md:py-36" aria-labelledby="journey-title">
  <div class="container-x grid gap-14 lg:grid-cols-[0.8fr_1.2fr]">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <p class="eyebrow" data-reveal>Journey</p>
      <h2 id="journey-title" class="mt-5 text-4xl font-semibold md:text-6xl" data-split>My journey in code.</h2>
      <p class="mt-6 max-w-md text-muted" data-reveal style="--d:1">
        From my first programs in high school to building complete products with AI — each step added something I still use every day.
      </p>
    </div>

    <div data-timeline class="relative ml-3 border-l border-line pl-10">
      <span
        data-timeline-fill
        class="absolute top-0 -left-px h-full w-px origin-top bg-gradient-to-b from-cyan via-violet to-pink"
        aria-hidden="true"></span>
      <ol>
      {
        journey.map((j, i) => (
          <li class="relative pb-14 last:pb-0" data-reveal style={`--d:${i % 3}`}>
            <span
              class="absolute top-1.5 -left-[2.95rem] grid h-4 w-4 place-items-center rounded-full border border-cyan/60 bg-bg"
              aria-hidden="true"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-cyan" />
            </span>
            <p class="font-mono text-xs tracking-wider text-cyan uppercase">{j.when}</p>
            <h3 class="mt-2 font-display text-2xl font-semibold">{j.title}</h3>
            <p class="mt-3 max-w-xl leading-relaxed text-muted">{j.body}</p>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>
