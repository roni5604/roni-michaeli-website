---
import { site } from '../data/site';
const btn =
  'grid h-10 w-10 place-items-center rounded-full text-muted transition-colors hover:bg-white/10 hover:text-ink focus-visible:bg-white/10';
---

<aside
  data-dock
  aria-label="Quick contact"
  transition:persist="dock"
  class="dock glass fixed bottom-4 left-1/2 z-40 flex max-w-[calc(100vw-1.5rem)] -translate-x-1/2 items-center gap-1 rounded-full p-1.5 shadow-[0_20px_60px_-15px_rgb(0_0_0/0.9)] md:right-6 md:bottom-6 md:left-auto md:translate-x-0"
>
  <a href="/#contact" class="flex items-center gap-2 rounded-full px-3 py-2 text-xs font-semibold whitespace-nowrap text-emerald-200 hover:bg-white/10">
    <span class="live-dot" aria-hidden="true"></span>
    <span class="min-[420px]:hidden">Available</span><span class="hidden min-[420px]:inline">Available for work</span>
  </a>
  <span class="mx-1 h-6 w-px bg-line" aria-hidden="true"></span>
  <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class={btn} aria-label="WhatsApp (opens in a new tab)" title="WhatsApp">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
      ></path></svg
    >
  </a>
  <a data-email={site.emailParts.join('|')} href="/#contact" class={btn} aria-label="Email" title="Email">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
      ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg
    >
  </a>
  <a href={site.github} target="_blank" rel="noopener noreferrer" class={btn} aria-label="GitHub (opens in a new tab)" title="GitHub">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"
      ></path></svg
    >
  </a>
  <a href={site.cv} target="_blank" rel="noopener" class={btn} aria-label="CV, PDF (opens in a new tab)" title="CV (PDF)">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
      ><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path></svg
    >
  </a>
</aside>

<style>
  .dock {
    transition:
      opacity 0.5s var(--ease-out-expo),
      translate 0.5s var(--ease-out-expo);
  }
  :global(html.js) .dock:not(.is-shown) {
    opacity: 0;
    translate: 0 120%;
    pointer-events: none;
  }
</style>
